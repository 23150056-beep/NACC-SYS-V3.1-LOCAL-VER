# NACC SYS V3 backend — environment template.
#
#   cp .env.example .env
#
# Every value here is a DEVELOPMENT default. Cloud deploys set these through
# the platform's environment/secret store instead of a file — see
# docs/CLOUD-DEPLOYMENT.md for the production values.

# ---- Core ----------------------------------------------------------------
# Required when DJANGO_DEBUG=False; the app refuses to boot without it.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Browser origins allowed to call the API, and to submit forms to it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Database ------------------------------------------------------------
# Cloud platforms provide DATABASE_URL; set it and the DB_* block is ignored.
# DATABASE_URL=postgres://user:password@host:5432/nacc_v3
# DB_SSL_REQUIRE=true       # managed Postgres reached over the public internet
# DB_CONN_MAX_AGE=600

# On-premises / legacy path. Leave DB_ENGINE unset for the SQLite fallback,
# which is what the test suite and a fresh checkout use.
# DB_ENGINE=postgres
# DB_NAME=nacc_v3
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---- Uploaded files (reports, consent scans, child photos) ---------------
FILE_UPLOAD_MAX_MB=15

# Container filesystems are ephemeral: anything written to MEDIA_ROOT is gone
# on the next deploy. Any cloud deploy must set USE_S3=true (or mount a
# persistent volume) or it WILL lose uploaded case files.
# The bucket must be private — files are served only through authenticated
# API endpoints, never from a public URL.
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=nacc-v3-media
# AWS_S3_REGION_NAME=ap-southeast-1
# AWS_S3_ENDPOINT_URL=          # blank for AWS S3; set for R2 / B2 / Supabase
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_URL_EXPIRY=300         # seconds a signed URL stays valid
# MEDIA_ROOT=                   # local-disk fallback; defaults to backend/media

# ---- HTTPS ---------------------------------------------------------------
# Applied only when DJANGO_DEBUG=False. Set to False behind a proxy that does
# not forward X-Forwarded-Proto, or the app will redirect in a loop.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# ---- Google Sign-In (optional — staff and psychologists only) -------------
# Unset = feature off; the login page shows only the password form.
#
# Accounts are NEVER created by signing in. An Administrator creates the user
# first, with the correct role and the person's Google address as their email;
# Google then replaces the password for that already-authorised account.
# Administrators always sign in with a password — the recovery account is
# deliberately not tied to a third-party identity provider.
#
# Get the client ID from Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application, with your frontend URL listed under
# "Authorised JavaScript origins". See docs/CLOUD-DEPLOYMENT.md §10.
# GOOGLE_OAUTH_CLIENT_ID=
#
# Optional: restrict to agency email domains, comma-separated. Empty means any
# Google address is accepted provided an account already exists for it.
# GOOGLE_ALLOWED_DOMAINS=racco1.gov.ph

# ---- Transactional mail (optional) ---------------------------------------
# One message only: "a case has been assigned to you", carrying the case
# number and nothing else. Leave the key unset and no mail is sent.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=racco1nacc@gmail.com
# BREVO_SENDER_NAME=NACC RACCO1

# ---- Text messages (optional) --------------------------------------------
# Three notices, each a prompt to sign in: a new case (case reference only), a
# temporary password is waiting (never the password), and a count of the next
# day's sessions. Plus the code that verifies someone's own number. Only a
# number its owner has verified in My Profile ever receives anything.
#
# Unset SMS_PROVIDER = nothing is sent; each message is written to the API
# window's log instead, verification codes included, which is how the local
# copy is meant to run. See docs/LOCAL-SETUP.md "Text messages".
#
# Semaphore (semaphore.co): copy the API key from its dashboard. A
# verification code goes by its OTP route at 2 credits; everything else is 1.
# SMS_PROVIDER=semaphore
# SMS_API_KEY=
# SMS_SENDER_NAME=NACC          # must be approved by Semaphore first; unset
#                               # uses their default sender
# SMS_ENDPOINT=                 # leave unset: each provider has its own URL
#
# Other gateways: SMS_PROVIDER=philsms, or textbee with SMS_DEVICE_ID=

# ---- Runtime (container only) --------------------------------------------
# PORT=8000
# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=180
# RUN_SEED=false                # true on first deploy: roles + default admin
